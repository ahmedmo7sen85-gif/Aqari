# ---------------------------------------------------------------------------
# Mirra environment variables
#
# NEVER commit real keys. NEVER paste a key into a chat/prompt.
# Set these in the hosting platform (Vercel -> Project -> Settings ->
# Environment Variables) for Production / Preview / Development.
# Every value here is server-side only: nothing is prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Google AI Studio key used by the Gemini provider adapter.
# Required for: image visualization, intent understanding, photo vision checks.
GEMINI_API_KEY=

# Optional overrides (defaults are in src/lib/providers/gemini.ts)
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_TEXT_MODEL=gemini-3-pro-preview
GEMINI_IMAGE_SIZE=2K

# Feature flags (see src/config/flags.ts). Unset = built-in default.
MIRRA_FLAG_INTENT_AGENT=on
MIRRA_FLAG_VISION_PHOTO_CHECK=on
MIRRA_FLAG_INTENSITY_VARIANTS=on
MIRRA_FLAG_DOCTOR_MATCHING=off
MIRRA_FLAG_PRICE_INTELLIGENCE=off
